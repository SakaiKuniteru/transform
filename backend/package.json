{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:dev": "node src/scripts/migrate.js",
    "migrate:prod": "node src/scripts/migrate.js",
    "storage:init": "node src/scripts/init-storage.js",
    "worker": "node src/workers/worker.js",
    "worker:chuyen-doi": "node src/workers/chuyen-doi.worker.js",
    "worker:tai-lieu": "node src/workers/tai-lieu.worker.js",
    "worker:du-lieu": "node src/workers/du-lieu.worker.js",
    "worker:nen": "node src/workers/nen.worker.js",
    "worker:hinh-anh": "node src/workers/hinh-anh.worker.js",
    "worker:email": "node src/workers/email.worker.js",
    "worker:ocr": "node src/workers/ocr.worker.js",
    "worker:dich": "node src/workers/dich.worker.js",
    "worker:ai": "node src/workers/ai.worker.js",
    "syntax:check": "node src/scripts/check-syntax.js",
    "modules:check": "node src/scripts/check-modules.js",
    "runtime:check": "node src/scripts/check-runtime.js",
    "email:check": "node src/scripts/check-email.js",
    "production:env:check": "node src/scripts/check-production-env.js",
    "smoke:prod": "node src/scripts/production-smoke.js",
    "test": "node --test",
    "test:prepare": "node tests/setup-test-db.js",
    "test:integration": "npm run test:prepare && node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:upload-limits": "npm run test:prepare && node --test --test-concurrency=1 tests/upload-limits/*.test.js",
    "test:storage:local": "TEST_STORAGE_DRIVER=local node --test --test-concurrency=1 tests/storage/local-storage.test.js",
    "test:storage:minio": "TEST_STORAGE_DRIVER=minio node --test --test-concurrency=1 tests/storage/minio-storage.test.js",
    "test:queue": "npm run test:prepare && node --test --test-concurrency=1 tests/queue/*.test.js",
    "test:email": "node --test --test-concurrency=1 tests/email/*.test.js",
    "test:auth": "npm run test:prepare && node --test --test-concurrency=1 tests/auth/*.test.js",
    "test:e2e:auth": "npm run test:prepare && node --test --test-concurrency=1 tests/e2e/auth-otp.e2e.test.js",
    "test:engine": "node --test --test-concurrency=1 tests/engine/*.test.js",
    "test:e2e:image": "npm run test:prepare && node --test --test-concurrency=1 tests/e2e/image.e2e.test.js",
    "test:e2e:conversion": "npm run test:prepare && node --test --test-concurrency=1 tests/e2e/conversion.e2e.test.js",
    "test:e2e:lifecycle": "npm run test:prepare && node --test --test-concurrency=1 tests/e2e/lifecycle.e2e.test.js",
    "test:e2e:local": "npm run test:prepare && node --test --test-concurrency=1 tests/e2e/*.test.js",
    "test:migration": "node --test --test-concurrency=1 tests/migration/*.test.js",
    "test:e2e:ocr": "npm run test:prepare && node --test --test-concurrency=1 tests/e2e/ocr.e2e.test.js",
    "test:storage:init": "TEST_STORAGE_DRIVER=minio TEST_MINIO_BUCKET=transform-init-test node --test --test-concurrency=1 tests/storage/storage-init.integration.test.js",
    "test:core": "npm run test:engine && npm run test:integration && npm run test:auth && npm run test:email && npm run test:upload-limits && npm run test:storage:local && npm run test:queue && npm run test:e2e:image"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@transform/shared": "file:../shared",
    "adm-zip": "^0.6.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.7",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
