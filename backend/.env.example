# ============================================================
# ỨNG DỤNG
# ============================================================

NODE_ENV=development
APP_NAME=transform-backend
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=2310
PUBLIC_BASE_URL=http://localhost:2310
API_PREFIX=/api/v1
TRUST_PROXY=false
HTTP_JSON_LIMIT=10mb
HTTP_URLENCODED_LIMIT=10mb
REQUEST_TIMEOUT_MS=300000


# ============================================================
# DATABASE - POSTGRESQL
# ============================================================

DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=transform
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=0
DB_QUERY_TIMEOUT_MS=0
DB_APPLICATION_NAME=transform-backend


# ============================================================
# REDIS
# ============================================================

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_KEEP_ALIVE_MS=10000
REDIS_MAX_RETRIES_PER_REQUEST=1


# ============================================================
# QUEUE - BULLMQ
# ============================================================

QUEUE_PREFIX=transform
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_TYPE=exponential
QUEUE_BACKOFF_DELAY_MS=5000
QUEUE_REMOVE_COMPLETE_AGE_SECONDS=86400
QUEUE_REMOVE_COMPLETE_COUNT=1000
QUEUE_REMOVE_FAIL_AGE_SECONDS=604800
QUEUE_REMOVE_FAIL_COUNT=5000
QUEUE_LOCK_DURATION_MS=300000
QUEUE_STALLED_INTERVAL_MS=30000
QUEUE_MAX_STALLED_COUNT=1
QUEUE_CONCURRENCY_DEFAULT=2
QUEUE_CONCURRENCY_TAI_LIEU=2
QUEUE_CONCURRENCY_DU_LIEU=4
QUEUE_CONCURRENCY_NEN=2
QUEUE_CONCURRENCY_HINH_ANH=4
QUEUE_CONCURRENCY_OCR=1
QUEUE_CONCURRENCY_DICH=2
QUEUE_CONCURRENCY_AI=1


# ============================================================
# STORAGE
# ============================================================

STORAGE_DRIVER=local
STORAGE_ROOT=./storage
STORAGE_ORIGINAL_DIR=original
STORAGE_WORKING_DIR=working
STORAGE_OUTPUT_DIR=output
STORAGE_TEMP_DIR=working/tmp
STORAGE_SIGNED_URL_EXPIRES_SECONDS=900
STORAGE_TEMP_CLEANER_ENABLED=true
STORAGE_TEMP_MAX_AGE_MS=86400000
STORAGE_TEMP_CLEAN_INTERVAL_MS=3600000


# ============================================================
# MINIO
# ============================================================

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-secret
MINIO_BUCKET=transform
MINIO_REGION=us-east-1
MINIO_PREFIX=


# ============================================================
# JWT
# ============================================================

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=transform-backend
JWT_AUDIENCE=transform-client


# ============================================================
# MẬT KHẨU
# ============================================================

BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128


# ============================================================
# OTP
# ============================================================

OTP_SECRET=change-me-otp-secret-at-least-32-characters
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5


# ============================================================
# COOKIE
# ============================================================

COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters
AUTH_REFRESH_COOKIE_NAME=transform_refresh_token
AUTH_REFRESH_COOKIE_MAX_AGE_MS=2592000000
GUEST_SESSION_COOKIE_NAME=transform_guest_token
GUEST_SESSION_TTL_MS=2592000000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=


# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:2320,http://127.0.0.1:2320
CORS_CREDENTIALS=true
CORS_ALLOW_NO_ORIGIN=true
CORS_MAX_AGE_SECONDS=86400


# ============================================================
# RATE LIMIT
# ============================================================

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10


# ============================================================
# UPLOAD
# ============================================================

UPLOAD_MAX_FILE_SIZE_MB=1024
UPLOAD_MAX_FILES=20
UPLOAD_MAX_FIELDS=50
UPLOAD_MAX_FIELD_SIZE_MB=2


# ============================================================
# PROCESS
# ============================================================

PROCESS_DEFAULT_TIMEOUT_MS=300000
PROCESS_MAX_BUFFER_BYTES=10485760


# ============================================================
# CÔNG CỤ CHUYỂN ĐỔI
# ============================================================

LIBREOFFICE_BIN=soffice
PANDOC_BIN=pandoc
TESSERACT_BIN=tesseract
SEVENZIP_BIN=7zz
PDFTOTEXT_BIN=pdftotext
PDFTOPPM_BIN=pdftoppm
QPDF_BIN=qpdf
GHOSTSCRIPT_BIN=gs


# ============================================================
# AI
# ============================================================

AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=120000


# ============================================================
# DỊCH
# ============================================================

TRANSLATION_PROVIDER=
TRANSLATION_BASE_URL=
TRANSLATION_API_KEY=
TRANSLATION_TIMEOUT_MS=120000