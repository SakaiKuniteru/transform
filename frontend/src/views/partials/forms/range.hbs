<div class="form-range">
    <input type="range" id="{{id}}" name="{{name}}" value="{{value}}" class="form-range__input{{#if hasError}} is-invalid{{/if}}" min="{{min}}" max="{{max}}" step="{{step}}"{{#if required}} required{{/if}}{{#if disabled}} disabled{{/if}}{{#if label}} aria-labelledby="{{id}}-label"{{/if}} aria-invalid="{{ariaInvalid}}"{{#if ariaDescribedBy}} aria-describedby="{{ariaDescribedBy}}"{{/if}}{{#each attributes}} {{@key}}="{{this}}"{{/each}}>
    <output class="form-range__value" for="{{id}}" data-range-output="{{id}}">{{value}}</output>
</div>