<div class="form-password">
    <input type="password" id="{{id}}" name="{{name}}" class="form-control form-password__input{{#if hasError}} is-invalid{{/if}}"{{#if placeholder}} placeholder="{{placeholder}}"{{/if}}{{#if autocomplete}} autocomplete="{{autocomplete}}"{{/if}}{{#if required}} required{{/if}}{{#if readonly}} readonly{{/if}}{{#if disabled}} disabled{{/if}}{{#if minLength}} minlength="{{minLength}}"{{/if}}{{#if maxLength}} maxlength="{{maxLength}}"{{/if}}{{#if pattern}} pattern="{{pattern}}"{{/if}}{{#if label}} aria-labelledby="{{id}}-label"{{/if}} aria-invalid="{{ariaInvalid}}"{{#if ariaDescribedBy}} aria-describedby="{{ariaDescribedBy}}"{{/if}}{{#each attributes}} {{@key}}="{{this}}"{{/each}}>
    <button type="button" class="form-password__toggle" data-password-toggle="{{id}}" aria-label="Hiển thị hoặc ẩn mật khẩu" aria-controls="{{id}}">Hiện</button>
</div>