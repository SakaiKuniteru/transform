<select id="{{id}}" name="{{name}}" class="form-control form-select{{#if hasError}} is-invalid{{/if}}"{{#if searchable}} data-searchable="true"{{/if}}{{#if allowAll}} data-allow-all="true"{{/if}}{{#if selectNative}} data-select-native="true"{{/if}}{{#if allValue}} data-all-value="{{allValue}}"{{/if}}{{#if multiple}} multiple{{/if}}{{#if required}} required{{/if}}{{#if disabled}} disabled{{/if}}{{#if label}} aria-labelledby="{{id}}-label"{{/if}} aria-invalid="{{ariaInvalid}}"{{#if ariaDescribedBy}} aria-describedby="{{ariaDescribedBy}}"{{/if}}{{#each attributes}} {{@key}}="{{this}}"{{/each}}>
    {{#if placeholder}}<option value="">{{placeholder}}</option>{{/if}}
    {{#each options}}<option value="{{value}}"{{#if selected}} selected{{/if}}{{#if disabled}} disabled{{/if}}>{{label}}</option>{{/each}}
</select>