<div class="upload-files" data-upload-files hidden>
    <div class="upload-files__header">
        <strong>Tệp đã chọn</strong>
        <span data-upload-file-count>0 tệp</span>
    </div>
    <ul class="upload-files__list" data-upload-file-list></ul>
    <template data-upload-file-template>
        <li class="upload-file">
            <span class="upload-file__name" data-upload-file-name></span>
            <span class="upload-file__size" data-upload-file-size></span>
        </li>
    </template>
</div>