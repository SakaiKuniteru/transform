<header class="user-header">
    <div class="user-header__left"><a href="/" class="user-header__brand" aria-label="Transform - Trang chủ">{{> common/brand compact=true}}</a></div>
    <nav class="user-header__nav" aria-label="Điều hướng người dùng">
        <a href="/cong-cu"{{#if (includes request.path "/cong-cu")}} class="is-active" aria-current="page"{{/if}}>Công cụ</a>
        <a href="/user"{{#if (eq request.path "/user")}} class="is-active" aria-current="page"{{/if}}>Tổng quan</a>
        <a href="/user/tep"{{#if (includes request.path "/user/tep")}} class="is-active" aria-current="page"{{/if}}>Tệp của tôi</a>
        <a href="/user/cong-viec"{{#if (includes request.path "/user/cong-viec")}} class="is-active" aria-current="page"{{/if}}>Công việc</a>
        <a href="/user/lich-su"{{#if (includes request.path "/user/lich-su")}} class="is-active" aria-current="page"{{/if}}>Lịch sử</a>
    </nav>
    <div class="user-header__right">{{> user/account-menu}}</div>
</header>
