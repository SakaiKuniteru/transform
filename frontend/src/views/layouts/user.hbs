<!DOCTYPE html>
<html lang="vi">
<head>
    {{> common/head}}
</head>
<body class="layout-user{{#if page.bodyClass}} {{page.bodyClass}}{{/if}}">
    <div class="user-layout" data-user-layout>
        {{> user/sidebar}}
        <div class="user-layout__content">
            {{> user/header}}
            <main class="user-main" id="main-content">
                {{#if breadcrumb}}{{> common/breadcrumb breadcrumb=breadcrumb}}{{/if}}
                {{{body}}}
            </main>
        </div>
    </div>
    {{> common/toast toasts=toasts}}
    {{> common/loading id="global-loading" text="Đang xử lý..." fullscreen=true}}
    {{#each assets.scripts}}<script src="{{src}}"{{#if defer}} defer{{/if}}{{#if async}} async{{/if}}{{#if type}} type="{{type}}"{{/if}}></script>{{/each}}
</body>
</html>