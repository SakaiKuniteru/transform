<section class="user-page user-jobs">
    <header class="user-page__header">
        <div>
            <h1 class="user-page__title">Công việc</h1>
            <p class="user-page__description">Theo dõi tiến trình và trạng thái các công việc xử lý.</p>
        </div>
        <a href="/user/chuyen-doi" class="btn btn-primary">Tạo chuyển đổi</a>
    </header>
    <section class="user-section">
        <form action="/user/cong-viec" method="GET" class="user-filter">
            <div class="user-filter__search">
                <label for="cong-viec-tu-khoa">Tìm kiếm</label>
                <input type="search" id="cong-viec-tu-khoa" name="tuKhoa" value="{{filters.tuKhoa}}" class="form-control" placeholder="Tệp, loại công việc, định dạng...">
            </div>
            <div class="user-filter__field">
                <label for="cong-viec-trang-thai">Trạng thái</label>
                <select id="cong-viec-trang-thai" name="trangThai" class="form-control form-select">
                    <option value="">Tất cả trạng thái</option>
                    {{#each trangThaiOptions}}<option value="{{value}}"{{#if (eq ../filters.trangThai value)}} selected{{/if}}>{{label}}</option>{{/each}}
                </select>
            </div>
            <div class="user-filter__field">
                <label for="cong-viec-loai">Loại công việc</label>
                <select id="cong-viec-loai" name="loaiCongViec" class="form-control form-select">
                    <option value="">Tất cả loại</option>
                    {{#each loaiCongViecOptions}}<option value="{{value}}"{{#if (eq ../filters.loaiCongViec value)}} selected{{/if}}>{{label}}</option>{{/each}}
                </select>
            </div>
            <div class="user-filter__field">
                <label for="cong-viec-tu-ngay">Từ ngày</label>
                <input type="date" id="cong-viec-tu-ngay" name="tuNgay" value="{{filters.tuNgay}}" class="form-control">
            </div>
            <div class="user-filter__field">
                <label for="cong-viec-den-ngay">Đến ngày</label>
                <input type="date" id="cong-viec-den-ngay" name="denNgay" value="{{filters.denNgay}}" class="form-control">
            </div>
            <div class="user-filter__actions">
                <button type="submit" class="btn btn-secondary">Tìm kiếm</button>
                <a href="/user/cong-viec" class="btn btn-link">Xóa lọc</a>
            </div>
        </form>
        {{#if danhSach.length}}
            <div class="user-table-wrapper">
                <table class="user-table">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Công việc</th>
                            <th>Tệp nguồn</th>
                            <th>Trạng thái</th>
                            <th>Tiến trình</th>
                            <th>Thời gian tạo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each danhSach}}
                            <tr>
                                <td>#{{id}}</td>
                                <td>
                                    <strong>{{loaiHienThi}}</strong>
                                    {{#if dinhDangNguon}}<span>{{dinhDangNguon}}{{#if dinhDangDich}} → {{dinhDangDich}}{{/if}}</span>{{/if}}
                                </td>
                                <td>{{#if tepNguon}}<a href="/user/tep/{{tepNguon.id}}">{{tepNguon.tenTep}}</a>{{else}}-{{/if}}</td>
                                <td><span class="job-status job-status--{{trangThai}}">{{trangThaiHienThi}}</span></td>
                                <td><progress value="{{tienTrinh}}" max="100">{{tienTrinh}}%</progress><span>{{tienTrinh}}%</span></td>
                                <td>{{createdAtHienThi}}</td>
                                <td><a href="/user/cong-viec/{{id}}" class="btn btn-sm btn-secondary">Chi tiết</a></td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{> common/pagination pagination=pagination}}
        {{else}}
            {{> common/empty-state title="Chưa có công việc" message="Các yêu cầu chuyển đổi và xử lý sẽ xuất hiện tại đây."}}
        {{/if}}
    </section>
</section>