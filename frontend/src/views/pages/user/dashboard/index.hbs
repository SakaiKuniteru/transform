<section class="user-page user-dashboard">
    <header class="user-page__header">
        <div>
            <span class="tf-page-eyebrow">WORKSPACE CỦA BẠN</span>
            <h1 class="user-page__title">Xin chào{{#if auth.nguoiDung.hoTen}}, {{auth.nguoiDung.hoTen}}{{/if}}!</h1>
            <p class="user-page__description">Chuyển đổi tài liệu, theo dõi tệp và công việc của bạn tại một nơi.</p>
        </div>
        <a href="/user/chuyen-doi" class="btn btn-primary">Chuyển đổi tệp</a>
    </header>
    <section class="tf-quick-tools" aria-label="Công cụ nhanh"><a href="/cong-cu/pdf-sang-word"><img src="/assets/images/icons/convert.svg" alt="" width="27" height="27"><span>PDF sang Word</span><span aria-hidden="true">→</span></a><a href="/cong-cu"><img src="/assets/images/icons/compress.svg" alt="" width="27" height="27"><span>Nén tệp</span><span aria-hidden="true">→</span></a><a href="/cong-cu"><img src="/assets/images/icons/scan.svg" alt="" width="27" height="27"><span>OCR &amp; hình ảnh</span><span aria-hidden="true">→</span></a><a href="/user/tep"><img src="/assets/images/icons/upload.svg" alt="" width="27" height="27"><span>Tải tệp lên</span><span aria-hidden="true">→</span></a></section>
    <div class="dashboard-stats">
        <article class="dashboard-stat">
            <span class="dashboard-stat__label">Tệp của tôi</span>
            <strong class="dashboard-stat__value">{{dashboard.thongKe.tongSoTep}}</strong>
            <a href="/user/tep" class="dashboard-stat__link">Xem tệp</a>
        </article>
        <article class="dashboard-stat">
            <span class="dashboard-stat__label">Công việc</span>
            <strong class="dashboard-stat__value">{{dashboard.thongKe.tongSoCongViec}}</strong>
            <a href="/user/cong-viec" class="dashboard-stat__link">Xem công việc</a>
        </article>
        <article class="dashboard-stat">
            <span class="dashboard-stat__label">Hoạt động</span>
            <strong class="dashboard-stat__value">{{dashboard.thongKe.tongSoLichSu}}</strong>
            <a href="/user/lich-su" class="dashboard-stat__link">Xem lịch sử</a>
        </article>
    </div>
    <div class="dashboard-grid">
        <section class="dashboard-section">
            <header class="dashboard-section__header">
                <h2>Tệp gần đây</h2>
                <a href="/user/tep">Xem tất cả</a>
            </header>
            {{#if dashboard.tepGanDay.length}}
                <div class="dashboard-list">
                    {{#each dashboard.tepGanDay}}
                        <a href="/user/tep/{{id}}" class="dashboard-list__item">
                            <div>
                                <strong>{{tenTep}}</strong>
                                <span>{{dinhDangHienThi}} · {{kichThuocHienThi}}</span>
                            </div>
                            <time>{{createdAtHienThi}}</time>
                        </a>
                    {{/each}}
                </div>
            {{else}}
                {{> common/empty-state title="Chưa có tệp" message="Tải tệp đầu tiên để bắt đầu sử dụng Transform." action=(lookup . "uploadAction")}}
            {{/if}}
        </section>
        <section class="dashboard-section">
            <header class="dashboard-section__header">
                <h2>Công việc gần đây</h2>
                <a href="/user/cong-viec">Xem tất cả</a>
            </header>
            {{#if dashboard.congViecGanDay.length}}
                <div class="dashboard-list">
                    {{#each dashboard.congViecGanDay}}
                        <a href="/user/cong-viec/{{id}}" class="dashboard-list__item">
                            <div>
                                <strong>{{loaiHienThi}}</strong>
                                <span>{{trangThaiHienThi}} · {{tienTrinh}}%</span>
                            </div>
                            <time>{{createdAtHienThi}}</time>
                        </a>
                    {{/each}}
                </div>
            {{else}}
                {{> common/empty-state title="Chưa có công việc" message="Các yêu cầu chuyển đổi sẽ xuất hiện tại đây."}}
            {{/if}}
        </section>
    </div>
    <section class="dashboard-section">
        <header class="dashboard-section__header">
            <h2>Hoạt động gần đây</h2>
            <a href="/user/lich-su">Xem tất cả</a>
        </header>
        {{#if dashboard.lichSuGanDay.length}}
            <div class="dashboard-list">
                {{#each dashboard.lichSuGanDay}}
                    <div class="dashboard-list__item">
                        <div>
                            <strong>{{tieuDe}}</strong>
                            {{#if moTa}}<span>{{moTa}}</span>{{/if}}
                        </div>
                        <time>{{createdAtHienThi}}</time>
                    </div>
                {{/each}}
            </div>
        {{else}}
            {{> common/empty-state title="Chưa có hoạt động" message="Hoạt động sử dụng hệ thống sẽ được ghi lại tại đây."}}
        {{/if}}
    </section>
</section>