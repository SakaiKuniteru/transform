<section class="user-page conversion-result" data-job-refresh-enabled="{{#if ketQua.congViec.canLamMoi}}true{{else}}false{{/if}}" data-job-refresh-url="/user/chuyen-doi/{{ketQua.congViec.id}}" data-job-refresh-interval="{{ketQua.congViec.lamMoiSauMs}}">
    <header class="user-page__header">
        <div>
            <h1 class="user-page__title">Kết quả chuyển đổi</h1>
            <p class="user-page__description">Theo dõi trạng thái và kết quả xử lý.</p>
        </div>
        <a href="/user/chuyen-doi" class="btn btn-secondary">Chuyển đổi khác</a>
    </header>
    <section class="user-section">
        <div class="conversion-result__header">
            <div>
                <span class="conversion-result__label">Công việc</span>
                <strong>#{{ketQua.congViec.id}}</strong>
            </div>
            {{> job/status trangThai=ketQua.congViec.trangThai trangThaiHienThi=ketQua.congViec.trangThaiHienThi}}
        </div>
        {{> job/progress tienTrinh=ketQua.congViec.tienTrinh}}
        {{#if ketQua.congViec.thongBao}}<p class="conversion-result__message">{{ketQua.congViec.thongBao}}</p>{{/if}}
    </section>
    <section class="user-section">
        <h2 class="user-section__title">Thông tin chuyển đổi</h2>
        <dl class="detail-list">
            <div><dt>Loại xử lý</dt><dd>{{ketQua.congViec.loaiHienThi}}</dd></div>
            <div><dt>Định dạng nguồn</dt><dd>{{ketQua.congViec.dinhDangNguon}}</dd></div>
            <div><dt>Định dạng đích</dt><dd>{{ketQua.congViec.dinhDangDich}}</dd></div>
            <div><dt>Trạng thái</dt><dd>{{ketQua.congViec.trangThaiHienThi}}</dd></div>
            <div><dt>Tiến trình</dt><dd>{{ketQua.congViec.tienTrinh}}%</dd></div>
            {{#if ketQua.congViec.buocHienTai}}<div><dt>Bước hiện tại</dt><dd>{{ketQua.congViec.buocHienTai}}</dd></div>{{/if}}
        </dl>
    </section>
    {{#if ketQua.congViec.tepKetQuaId}}
        <section class="user-section">
            <h2 class="user-section__title">Tệp kết quả</h2>
            {{> job/result tepKetQua=ketQua.congViec.tepKetQua tepKetQuaId=ketQua.congViec.tepKetQuaId phienBanKetQua=ketQua.congViec.phienBanKetQua tepKetQuaKichThuocHienThi=ketQua.congViec.tepKetQuaKichThuocHienThi}}
        </section>
    {{/if}}
    {{#if ketQua.congViec.maLoi}}
        <section class="user-section user-section--danger">
            <h2 class="user-section__title">Lỗi xử lý</h2>
            <p><strong>{{ketQua.congViec.maLoi}}</strong></p>
            {{#if ketQua.congViec.thongBao}}<p>{{ketQua.congViec.thongBao}}</p>{{/if}}
        </section>
    {{/if}}
</section>