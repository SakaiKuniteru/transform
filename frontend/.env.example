NODE_ENV=development

APP_NAME=Transform
APP_VERSION=1.0.0

HOST=0.0.0.0
PORT=2320
PUBLIC_BASE_URL=http://localhost:2320
TRUST_PROXY=false

API_BASE_URL=http://127.0.0.1:2310/api/v1
API_TIMEOUT_MS=30000

SESSION_SECRET=change-me-development-only
SESSION_NAME=transform.sid
SESSION_MAX_AGE_MS=604800000
SESSION_SECURE=false
SESSION_SAME_SITE=lax

SESSION_REDIS_PREFIX=transform:frontend:session:
SESSION_REDIS_TTL_SECONDS=604800

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_KEEP_ALIVE_MS=10000
REDIS_MAX_RETRIES_PER_REQUEST=1

CSRF_ENABLED=true
CSRF_HEADER=x-csrf-token
HTML_MINIFY=false

HTTP_JSON_LIMIT=2mb
HTTP_URLENCODED_LIMIT=2mb

REQUEST_TIMEOUT_MS=300000
SHUTDOWN_TIMEOUT_MS=10000
ASSET_MAX_AGE_MS=0